{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@playwright/mcp"],
      "enabled": true,
      "env": { "BROWSER": "chromium" }
    },
    "axe": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@axe-core/mcp"],
      "enabled": true
    }
  }
}